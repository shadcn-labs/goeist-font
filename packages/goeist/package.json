{
  "name": "goeist",
  "version": "0.0.1",
  "description": "Goeist is Shadcn Labs' font family, including Goeist Sans and Goeist Mono.",
  "type": "module",
  "license": "OFL-1.1",
  "author": "Aniket Pawar <pawaraniket508@gmail.com>",
  "homepage": "https://shadcn-labs.com/font",
  "bugs": {
    "url": "https://github.com/shadcn-labs/goeist-font/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadcn-labs/goeist-font.git",
    "directory": "packages/goeist"
  },
  "keywords": [
    "goeist",
    "font",
    "typeface",
    "monospace",
    "rounded",
    "geist",
    "next/font",
    "variable font",
    "woff2"
  ],
  "exports": {
    "./font/sans": {
      "types": "./font/sans.d.ts",
      "default": "./font/sans.js"
    },
    "./font/sans-non-variable": {
      "types": "./font/sans-non-variable.d.ts",
      "default": "./font/sans-non-variable.js"
    },
    "./font/mono": {
      "types": "./font/mono.d.ts",
      "default": "./font/mono.js"
    },
    "./font/mono-non-variable": {
      "types": "./font/mono-non-variable.d.ts",
      "default": "./font/mono-non-variable.js"
    },
    "./sans.css": "./assets/goeist-sans/goeist-sans.css",
    "./sans-static.css": "./assets/goeist-sans/goeist-sans-static.css",
    "./mono.css": "./assets/goeist-mono/goeist-mono.css",
    "./mono-static.css": "./assets/goeist-mono/goeist-mono-static.css",
    "./package.json": "./package.json"
  },
  "files": [
    "font",
    "assets",
    "LICENSE.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/stage-assets.mjs",
    "prepack": "node scripts/stage-assets.mjs",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "peerDependencies": {
    "next": ">=13.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
