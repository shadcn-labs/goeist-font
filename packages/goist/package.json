{
  "name": "goist",
  "version": "1.1.0",
  "description": "Goist and Goist Mono, rounded typefaces by Aniket-508 developed under Shadcn Labs and based on Geist Sans and Geist Mono, for next/font and plain CSS.",
  "type": "module",
  "license": "OFL-1.1",
  "author": "Aniket-508 <pawaraniket508@gmail.com>",
  "homepage": "https://shadcn-labs.com/font",
  "bugs": {
    "url": "https://github.com/shadcn-labs/goist/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadcn-labs/goist.git",
    "directory": "packages/goist"
  },
  "keywords": [
    "goist",
    "font",
    "typeface",
    "monospace",
    "rounded",
    "geist",
    "next/font",
    "variable font",
    "woff2"
  ],
  "exports": {
    "./font/sans": {
      "types": "./font/sans.d.ts",
      "default": "./font/sans.js"
    },
    "./font/sans-non-variable": {
      "types": "./font/sans-non-variable.d.ts",
      "default": "./font/sans-non-variable.js"
    },
    "./font/mono": {
      "types": "./font/mono.d.ts",
      "default": "./font/mono.js"
    },
    "./font/mono-non-variable": {
      "types": "./font/mono-non-variable.d.ts",
      "default": "./font/mono-non-variable.js"
    },
    "./sans.css": "./assets/goist-sans/goist-sans.css",
    "./sans-static.css": "./assets/goist-sans/goist-sans-static.css",
    "./mono.css": "./assets/goist-mono/goist-mono.css",
    "./mono-static.css": "./assets/goist-mono/goist-mono-static.css",
    "./package.json": "./package.json"
  },
  "files": [
    "font",
    "assets",
    "LICENSE.txt"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/stage-assets.mjs",
    "prepack": "node scripts/stage-assets.mjs"
  },
  "peerDependencies": {
    "next": ">=13.2.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
